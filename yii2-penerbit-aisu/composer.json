{
    "name": "aisu/penerbit-buku",
    "description": "Aplikasi Web Penerbit Asosiasi Informatika Sumatera Utara berbasis Yii2 Basic Template",
    "keywords": ["yii2", "framework", "basic", "penerbit", "aisu", "seo", "books"],
    "homepage": "https://penerbit.aisu.or.id",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "email": "tomysatriaalasi@gmail.com"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4.33 <8.3.0",
        "yiisoft/yii2": "~2.0.45",
        "yiisoft/yii2-bootstrap4": "~2.0.10",
        "yiisoft/yii2-swiftmailer": "~2.1.2"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0"
    },
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "web/uploads/cover": "0777",
                    "yii": "0755"
                }
            ]
        }
    }
}
